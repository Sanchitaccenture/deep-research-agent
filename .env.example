# === Required keys ===
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
# Get from: https://app.tavily.com  (free tier ~1000 searches/month)
TAVILY_API_KEY=your_tavily_key_here

# === Optional keys (unlock extra providers) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === LLM models ===
GROQ_MODEL=openai/gpt-oss-20b
CREW_MODEL=openai/gpt-oss-120b
# Comma-separated fallback chain tried after GROQ_MODEL (rate limits, retired models)
GROQ_MODEL_CHAIN=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
# Reasoning effort for openai/gpt-oss-* models: low, medium, high (empty = provider default)
REASONING_EFFORT=low

# === Research loop budgets ===
MAX_SUBQUESTIONS=4
RESULTS_PER_SEARCH=4
MAX_ROUNDS=3
# Total characters of source text sent to the synthesis prompt (split evenly across sources)
SYNTH_CONTEXT_CHARS=12000

# === RAG ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# === Data directories ===
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma
SESSIONS_DIR=./data/sessions
UPLOADS_DIR=./data/uploads
COLLECTION_NAME=research_docs

# === Feature flags ===
ENABLE_RAG=true
ENABLE_CREW=true
CREW_VERBOSE=false

# === API ===
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
